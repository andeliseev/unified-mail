{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Mail",
  "version": "0.1.5",
  "identifier": "io.unifiedmail.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Unified Mail",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data: https:; media-src 'none'; object-src 'none'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDRDBGN0YyM0EwNTcxRDcKUldUWGNRVTY4dmZRakJVMkx2YnBCejVVSWNnVmY0ckpyNGRncENocXBDS3ZZeUkxaE1rK2VUSC8K",
      "endpoints": ["https://github.com/andeliseev/unified-mail/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
